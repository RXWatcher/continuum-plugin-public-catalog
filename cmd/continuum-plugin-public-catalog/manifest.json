{
  "plugin_id": "continuum.public-catalog",
  "version": "1.0.1",
  "checksum": "__CHECKSUM__",
  "continuum_api_version": "v1",
  "category": "Sharing",
  "supported_platforms": [
    {
      "os": "linux",
      "arch": "amd64"
    }
  ],
  "capabilities": [
    {
      "type": "http_routes.v1",
      "id": "public-catalog",
      "display_name": "Public Catalog",
      "description": "Public advertising page with stats, embedded HTML, and signed-token catalog browsing."
    }
  ],
  "http_routes": [
    {
      "id": "public_page",
      "method": "GET",
      "path": "/",
      "access": "public"
    },
    {
      "id": "catalog_page",
      "method": "GET",
      "path": "/catalog",
      "access": "public"
    },
    {
      "id": "item_page",
      "method": "GET",
      "path": "/item/*",
      "access": "public"
    },
    {
      "id": "public_api",
      "method": "*",
      "path": "/api/public/*",
      "access": "public"
    },
    {
      "id": "catalog_api",
      "method": "*",
      "path": "/api/catalog/*",
      "access": "public"
    },
    {
      "id": "admin_api",
      "method": "*",
      "path": "/api/admin/*",
      "access": "admin"
    },
    {
      "id": "admin_page",
      "method": "GET",
      "path": "/admin",
      "access": "admin",
      "navigable": true,
      "navigation_label": "Public Catalog",
      "navigation_kind": "admin"
    }
  ],
  "global_config_schema": [
    {
      "key": "database_url",
      "title": "Postgres connection string",
      "description": "DSN for the dedicated public_catalog schema (e.g. postgres://plugin_public_catalog:...@host:5432/continuum?search_path=public_catalog&sslmode=disable).",
      "json_schema": "{\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"string\"}},\"required\":[\"value\"]}",
      "required": true,
      "admin_form": {
        "fields": [
          {
            "key": "value",
            "label": "Connection URL",
            "control": "ADMIN_FORM_CONTROL_PASSWORD",
            "required": true,
            "secret": true
          }
        ]
      }
    }
  ]
}
